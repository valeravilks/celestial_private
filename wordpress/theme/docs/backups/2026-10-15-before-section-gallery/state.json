        "post_date_gmt": "2026-10-14 17:29:42",
        "post_content": "<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"0\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:group {\"anchor\":\"intro\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"intro\" class=\"wp-block-group alignfull has-contrast-color has-base-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">МЕБЕЛЬ ПОД ВАШ РИТМ ЖИЗНИ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Корпусная мебель.\nТочно на своём месте.<\/h1>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n\n<!-- wp:paragraph -->\n<p>Кухни, шкафы и системы хранения на заказ. От первого эскиза до аккуратной установки — с вниманием к пространству и вашим привычкам.<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"#request\">Обсудить проект<\/a><\/div>\n<!-- \/wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"#solutions\">Посмотреть решения<\/a><\/div>\n<!-- \/wp:button -->\n<\/div>\n<!-- \/wp:buttons -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:image {\"className\":\"furniture-demo-media\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full furniture-demo-media\"><img src=\"http:\/\/localhost:8888\/wp-content\/themes\/theme\/assets\/images\/furniture-demo\/kitchen-main.jpg\" alt=\"Современная кухня с деревянными фасадами и островом\" width=\"1600\" height=\"800\"\/><\/figure>\n<!-- \/wp:image -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"directions\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"surface\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"directions\" class=\"wp-block-group alignfull has-contrast-color has-surface-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">ЧТО МЫ СОЗДАЁМ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">У каждого пространства — своё решение.<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/cooking-pot\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Кухни<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Продуманная рабочая зона, удобное хранение и фасады, которые поддерживают характер интерьера.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/door-open\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Шкафы и гардеробные<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>От компактной прихожей до отдельной гардеробной. Используем пространство от пола до потолка.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/layers\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Мебель для всего дома<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Тумбы, стеллажи и встроенные системы. Единый язык материалов для гостиной, спальни и рабочего места.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"solutions\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"solutions\" class=\"wp-block-group alignfull has-contrast-color has-base-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">ВИЗУАЛЬНОЕ НАПРАВЛЕНИЕ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Материалы, с которыми хочется жить.<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:image {\"className\":\"furniture-demo-media\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full furniture-demo-media\"><img src=\"http:\/\/localhost:8888\/wp-content\/themes\/theme\/assets\/images\/furniture-demo\/kitchen-light.jpg\" alt=\"Светлая кухня с островом и деревянными шкафами\" width=\"1200\" height=\"800\"\/><\/figure>\n<!-- \/wp:image -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Свет и натуральные фактуры<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Светлые поверхности и древесный рисунок создают спокойное пространство на каждый день.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:image {\"className\":\"furniture-demo-media\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-full furniture-demo-media\"><img src=\"http:\/\/localhost:8888\/wp-content\/themes\/theme\/assets\/images\/furniture-demo\/kitchen-detail.jpg\" alt=\"Кухня с деревянными фасадами и светлой столешницей\" width=\"1200\" height=\"800\"\/><\/figure>\n<!-- \/wp:image -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Чистые линии. Ничего лишнего.<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Встроенное хранение, аккуратные стыки и внимание к деталям вместо визуального шума.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:paragraph -->\n<p>Изображения — референсы для тестовой версии, а не фотографии выполненных заказов.<\/p>\n<!-- \/wp:paragraph -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"benefits\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"surface\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"benefits\" class=\"wp-block-group alignfull has-contrast-color has-surface-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">ПРОДУМАНО ДЛЯ ВАС<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Красиво снаружи. Удобно каждый день.<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/ruler\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Под ваши размеры<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Учитываем ниши, коммуникации и особенности помещения, а не подгоняем комнату под готовый модуль.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/sliders-horizontal\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Под ваши привычки<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Разбираемся, что и где вы храните, как готовите и пользуетесь пространством.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/palette\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Под ваш интерьер<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Сочетаем фасады, столешницы и фурнитуру в цельную композицию.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/clipboard-list\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Понятная комплектация<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>До начала изготовления обсуждаем материалы, наполнение и состав работ.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/hammer\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">От проекта до установки<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Планируем замер, изготовление и монтаж как этапы одной задачи.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:icon {\"icon\":\"lucide\/message-circle\"} \/-->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Диалог на каждом этапе<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Объясняем решения и согласуем детали, которые влияют на результат.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"process\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"process\" class=\"wp-block-group alignfull has-contrast-color has-base-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">КАК МЫ РАБОТАЕМ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Начинаем с разговора, заканчиваем деталями.<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">01 \/ Задача<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Расскажите о помещении, покажите план или несколько фотографий. Обсудим идеи и ориентиры по бюджету.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">02 \/ Проект<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>Уточним размеры, предложим компоновку и подберём материалы. Зафиксируем согласованные решения.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">03 \/ Изготовление<\/h3>\n<!-- \/wp:heading -->\n<!-- wp:paragraph -->\n<p>После согласования подготовим мебель к установке. Даты и состав работ определяются для конкретного проекта.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"questions\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"surface\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"questions\" class=\"wp-block-group alignfull has-contrast-color has-surface-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">ПЕРЕД ПЕРВЫМ ШАГОМ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Несколько вопросов о мебели на заказ.<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Что нужно для предварительного обсуждения?<\/summary><!-- wp:paragraph -->\n<p>План помещения или примерные размеры, фотографии и несколько примеров того, что вам нравится. Точные размеры уточняются при замере.<\/p>\n<!-- \/wp:paragraph -->\n<\/details>\n<!-- \/wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Можно ли заказать мебель для нестандартной ниши?<\/summary><!-- wp:paragraph -->\n<p>Да, именно такие задачи удобно решать индивидуальным проектом. Сначала проверяем размеры и ограничения помещения.<\/p>\n<!-- \/wp:paragraph -->\n<\/details>\n<!-- \/wp:details -->\n<!-- wp:details -->\n<details class=\"wp-block-details\"><summary>Как узнать стоимость и сроки?<\/summary><!-- wp:paragraph -->\n<p>Они зависят от размеров, материалов, фурнитуры и сложности монтажа. Конкретное предложение составляется после обсуждения задачи.<\/p>\n<!-- \/wp:paragraph -->\n<\/details>\n<!-- \/wp:details -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<!-- wp:group {\"anchor\":\"request\",\"tagName\":\"section\",\"align\":\"full\",\"backgroundColor\":\"base\",\"textColor\":\"contrast\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|70\"},\"blockGap\":\"var:preset|spacing|60\"}},\"layout\":{\"type\":\"constrained\"},\"templateLock\":\"contentOnly\"} -->\n<section id=\"request\" class=\"wp-block-group alignfull has-contrast-color has-base-background-color has-text-color has-background\" style=\"padding-top:var(--wp--preset--spacing--70);padding-bottom:var(--wp--preset--spacing--70)\"><!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|20\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:paragraph {\"className\":\"is-style-subtitle\"} -->\n<p class=\"is-style-subtitle\">ДАВАЙТЕ НАЧНЁМ<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:heading {\"level\":2} -->\n<h2 class=\"wp-block-heading\">Какое пространство вы хотите изменить?<\/h2>\n<!-- \/wp:heading -->\n<\/div>\n<!-- \/wp:group -->\n<!-- wp:group {\"style\":{\"spacing\":{\"blockGap\":\"var:preset|spacing|50\"}},\"layout\":{\"type\":\"default\"}} -->\n<div class=\"wp-block-group\">\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:paragraph -->\n<p>Опишите вашу задачу — кухня, шкаф или мебель для нескольких комнат. Можно начать с плана, фотографии и пары идей.<\/p>\n<!-- \/wp:paragraph -->\n<!-- wp:paragraph -->\n<p><strong>Форма — демонстрационный бренд.<\/strong> Контакты и заявки в этой тестовой версии не работают.<\/p>\n<!-- \/wp:paragraph -->\n<\/div>\n<!-- \/wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:html -->\n<form class=\"furniture-demo-form\" aria-label=\"Демонстрационная форма заявки\"><label>Ваше имя<input type=\"text\" placeholder=\"Как к вам обращаться\" autocomplete=\"name\" \/><\/label><label>Контакт для связи<input type=\"text\" placeholder=\"Телефон или email\" \/><\/label><label>Что планируете?<textarea rows=\"3\" placeholder=\"Например: кухня в квартиру, помещение 12 м²\"><\/textarea><\/label><button type=\"button\" disabled>Обсудить проект<\/button><p>Тестовая форма — данные не отправляются.<\/p><\/form>\n<!-- \/wp:html -->\n<\/div>\n<!-- \/wp:column -->\n<\/div>\n<!-- \/wp:columns -->\n<\/div>\n<!-- \/wp:group -->\n<\/section>\n<!-- \/wp:group -->\n<\/div>\n<!-- \/wp:group -->",
