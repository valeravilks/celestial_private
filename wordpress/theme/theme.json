{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "720px",
      "wideSize": "1100px"
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#007A58"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#3156A3"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#FFC107"
        },
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#242628"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F4F6F8"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#58616A"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#167341"
        },
        {
          "slug": "warning",
          "name": "Warning",
          "color": "#855600"
        },
        {
          "slug": "error",
          "name": "Error",
          "color": "#B42318"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "blockGap": true,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "10",
          "size": "0.25rem"
        },
        {
          "slug": "20",
          "name": "20",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "30",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "40",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "50",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "60",
          "size": "2rem"
        },
        {
          "slug": "70",
          "name": "70",
          "size": "clamp(2.5rem, 5vw, 4rem)"
        },
        {
          "slug": "80",
          "name": "80",
          "size": "clamp(4rem, 8vw, 6rem)"
        },
        {
          "slug": "90",
          "name": "90",
          "size": "clamp(6rem, 10vw, 8rem)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    }
  }
}
