{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1600px",
      "allowEditing": false,
      "allowSizingOnChildren": false
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#007A58"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#3156A3"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#FFC107"
        },
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#242628"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F4F6F8"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#58616A"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "#167341"
        },
        {
          "slug": "warning",
          "name": "Warning",
          "color": "#855600"
        },
        {
          "slug": "error",
          "name": "Error",
          "color": "#B42318"
        }
      ],
      "background": false,
      "text": false,
      "link": false,
      "customGradient": false,
      "defaultGradients": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": []
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "blockGap": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "10",
          "size": "0.25rem"
        },
        {
          "slug": "20",
          "name": "20",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "30",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "40",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "50",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "60",
          "size": "2rem"
        },
        {
          "slug": "70",
          "name": "70",
          "size": "clamp(2.5rem, 5vw, 4rem)"
        },
        {
          "slug": "80",
          "name": "80",
          "size": "clamp(4rem, 8vw, 6rem)"
        },
        {
          "slug": "90",
          "name": "90",
          "size": "clamp(6rem, 10vw, 8rem)"
        }
      ],
      "padding": false,
      "margin": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontFamily": "Ubuntu",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/ubuntu/ubuntu-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Ubuntu",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": [
                "file:./assets/fonts/ubuntu/ubuntu-700-normal.woff2"
              ]
            }
          ],
          "fontFamily": "Ubuntu, sans-serif",
          "name": "Ubuntu",
          "slug": "ubuntu"
        },
        {
          "fontFace": [
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/roboto/roboto-400-normal.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": [
                "file:./assets/fonts/roboto/roboto-700-normal.woff2"
              ]
            }
          ],
          "fontFamily": "Roboto, sans-serif",
          "name": "Roboto",
          "slug": "roboto"
        }
      ],
      "fontSizes": [
        {
          "slug": "sm",
          "name": "SM",
          "size": "0.875rem"
        },
        {
          "slug": "md",
          "name": "MD",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.5rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "1.75rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "2rem"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "2.5rem"
        }
      ],
      "defaultFontSizes": false,
      "customFontSize": false,
      "fluid": false,
      "fontWeight": false,
      "lineHeight": false,
      "letterSpacing": false,
      "fontStyle": false,
      "textTransform": false,
      "textDecoration": false,
      "dropCap": false
    },
    "custom": {
      "fontWeight": {
        "bold": "700",
        "regular": "400"
      },
      "lineHeight": {
        "normal": "1.6",
        "relaxed": "1.75",
        "snug": "1.4",
        "tight": "1.2"
      },
      "letterSpacing": {
        "normal": "0",
        "wide": "0.08em"
      }
    },
    "useRootPaddingAwareAlignments": true,
    "appearanceTools": false,
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "dimensions": {
      "minHeight": false,
      "aspectRatio": false
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|ubuntu",
      "fontSize": "var:preset|font-size|md",
      "fontWeight": "var:custom|font-weight|regular",
      "lineHeight": "var:custom|line-height|normal",
      "letterSpacing": "var:custom|letter-spacing|normal"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|ubuntu",
          "fontWeight": "var:custom|font-weight|bold",
          "lineHeight": "var:custom|line-height|tight"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4-xl)",
          "lineHeight": "var:custom|line-height|tight"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "lineHeight": "var:custom|line-height|tight"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "lineHeight": "var:custom|line-height|tight"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|xl",
          "lineHeight": "var:custom|line-height|tight"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var:preset|font-size|lg",
          "lineHeight": "var:custom|line-height|snug"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "lineHeight": "var:custom|line-height|snug"
        }
      }
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|40",
        "right": "var:preset|spacing|40",
        "top": "0px",
        "bottom": "0px"
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "content-index",
      "title": "Content: index",
      "area": "uncategorized"
    },
    {
      "name": "content-page",
      "title": "Content: page",
      "area": "uncategorized"
    },
    {
      "name": "content-single",
      "title": "Content: single",
      "area": "uncategorized"
    },
    {
      "name": "content-archive",
      "title": "Content: archive",
      "area": "uncategorized"
    },
    {
      "name": "content-search",
      "title": "Content: search",
      "area": "uncategorized"
    },
    {
      "name": "content-404",
      "title": "Content: 404",
      "area": "uncategorized"
    },
    {
      "name": "content-front-page",
      "title": "Content: Front Page",
      "area": "uncategorized"
    }
  ]
}
