{
  "name": "celestial",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start:block": "wp-scripts start --source-path=blocks --output-path=build/blocks --blocks-manifest",
    "start:editor": "wp-scripts start editor/index.js --output-path=build/editor",
    "start": "run-p start:*",
    "build:block": "wp-scripts build --source-path=blocks --output-path=build/blocks --blocks-manifest",
    "build:editor": "wp-scripts build editor/index.js --output-path=build/editor",
    "build": "run-p build:*"
  },
  "devDependencies": {
    "@wordpress/scripts": "32.0.0",
    "npm-run-all": "4.1.5"
  }
}
